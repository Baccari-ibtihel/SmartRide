flowchart LR
    User["👤 User / Passenger"]
    
    subgraph SmartRide ["SmartRide System"]
        direction TB
        UC1("( Search & View Trips )")
        UC2("( Book Trip )")
        UC3("( Complete Payment )")
        UC4("( Log In )")

        UC2 -. "<<include>>" .-> UC1
        UC2 -. "<<include>>" .-> UC3
    end

    Auth["⚙️ <<service>>\nAuthentication"]
    IdP["🔑 Identity Provider"]
    PaymentServ["💳 Payment Service"]
    AIMatching["🤖 AI Matching Engine"]

    User --- UC1
    User --- UC2
    User --- UC4

    UC1 --- AIMatching
    UC4 --- Auth
    UC4 --- IdP
    UC3 --- PaymentServ
