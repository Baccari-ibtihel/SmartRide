classDiagram
    direction TB

    class Candidate {
        +Long id
        +String firstname
        +String lastname
        +String email
    }

    class Address {
        +Long id
        +String street
        +String houseNumber
        +String zipCode
    }

    class Application {
        +Long id
        +Date applicationDate
        +String motivation
    }

    class Job {
        +Long id
        +String name
        +String description
        +Boolean available
        +Date date
    }

    class Category {
        +Long id
        +String name
        +String description
    }

    class Meeting {
        +Long id
        +String reference
        +String link
        +String status
    }

    class Notification {
        +Long id
        +String sender
        +String recipient
        +String content
        +Date date
    }

    Candidate "1" -- "0..*" Application : applies
    Application "0..*" -- "1" Job : for
    Job "0..*" -- "1" Category : belongs_to
    Application "1" -- "0..*" Meeting : schedules
    Application "1" -- "0..*" Notification : generates
