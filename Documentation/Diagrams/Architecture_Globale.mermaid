graph TD
    classDef frontend fill:#1e2454,stroke:#0d5c80,stroke-width:2px,color:#ffffff,font-weight:bold;
    classDef gateway fill:#0d5c80,stroke:#0e85a3,stroke-width:2px,color:#ffffff,font-weight:bold;
    classDef service fill:#147291,stroke:#ffffff,stroke-width:1px,color:#ffffff,font-weight:bold;

    Frontend["Frontend (Angular)"]:::frontend
    Gateway["API Gateway"]:::gateway

    User["User"]:::service
    Trip["Trip"]:::service
    Booking["Booking"]:::service
    Payment["Payment"]:::service

    RatingChat["Rating/Chat"]:::service
    NotifTrack["Notif/Track"]:::service
    MatchingIA["Matching (IA)"]:::service
